# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/royal_flame

# JWT Secret Key for Authentication
JWT_SECRET=royal_flame_luxury_secret_key_2026_@jwt
JWT_EXPIRES_IN=7d

# If true and local MongoDB is offline, server will start an embedded in-memory MongoDB instance automatically
USE_MEMORY_DB_FALLBACK=true
